JOBS_REDIS_URL=redis://127.0.0.1:6381
JOBS_CONCURRENCY=5

# Registry hosts are an explicit comma-separated allowlist. The development
# worker supports one optional Basic credential resolved from its environment;
# credentials never enter a BullMQ payload.
RADIUS_PLATFORM_REGISTRIES=127.0.0.1:5001
RADIUS_PLATFORM_INSECURE_REGISTRIES=
RADIUS_PLATFORM_REGISTRY_ENDPOINTS={}
RADIUS_PLATFORM_REGISTRY_USERNAME=radius-dev
RADIUS_PLATFORM_REGISTRY_PASSWORD=radius-dev-only
RADIUS_PLATFORM_ALLOW_INSECURE_LOOPBACK=true
