VITE_RADIUS_CLOUD_WEB_URL=http://localhost:3300
RADIUS_CONNECTOR_CATALOG_URL=http://localhost:3100/api/connector-catalog/v1/

# Manual local-agent spike only. Installed releases will use verified local
# installation state instead of environment paths.
RADIUS_AGENT_RELEASE_PATH=
RADIUS_AGENT_RUNTIME_ROOT=
RADIUS_AGENT_DEVELOPER_STATE_SHARE=
RADIUS_RUNTIME_DEBUG=0

# Optional Platform installation reporting. Configure all four together.
# The token needs installation.write and is never persisted by the desktop.
RADIUS_PLATFORM_API_URL=
RADIUS_PLATFORM_ACCESS_TOKEN=
RADIUS_PLATFORM_ORGANIZATION=
RADIUS_RUNTIME_VERSION=
RADIUS_PLATFORM_ALLOW_INSECURE_API=false
