{
  "name": "@curve-ai/radius-desktop",
  "productName": "Radius",
  "version": "0.0.1",
  "description": "The Radius desktop workspace for local AI agents.",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Curve AI"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/curve-ai/radius.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "bun run typecheck && bun run build:bundle",
    "build:bundle": "electron-vite build",
    "package": "bun run build && electron-builder --dir",
    "make": "bun run build && electron-builder",
    "lint": "eslint --cache .",
    "test": "tsx --test --test-force-exit 'src/**/*.test.ts'",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@curve-ai/platform-client": "0.0.1",
    "@curve-ai/radius-browser-protocol": "0.0.1",
    "@curve-ai/radius-browser-tools": "0.0.1",
    "@curve-ai/radius-mcp-connector": "0.0.1",
    "@curve-ai/radius-runtime": "0.0.1",
    "@curve-ai/radius-scheduler": "0.0.1",
    "@curve-ai/radius-storage": "0.0.1",
    "@curve-ai/radius-sync-core": "0.0.1",
    "@curve-ai/radius-tool-broker": "0.0.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bufferutil": "4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.14",
    "electron-updater": "6.8.9",
    "katex": "0.18.4",
    "lucide-react": "^0.554.0",
    "material-icon-theme": "5.37.0",
    "mermaid": "11.17.2",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-flagpack": "^2.0.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-definition-list": "2.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "tailwind-merge": "^3.4.0",
    "utf-8-validate": "6.0.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.7",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "build": {
    "appId": "ai.curve.radius",
    "publish": [
      {
        "provider": "github",
        "owner": "curve-ai",
        "repo": "radius",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../../packages/storage/drizzle",
        "to": "storage-migrations"
      },
      {
        "from": "../browser-extension/dist",
        "to": "browser-extension"
      },
      {
        "from": "../browser-native-host/dist",
        "to": "browser-native-host"
      }
    ],
    "mac": {
      "minimumSystemVersion": "26.0.0",
      "extraResources": [
        {
          "from": "../runtime-host-macos/.build/release/radius-runtime-host",
          "to": "runtime/macos-arm64/radius-runtime-host"
        },
        {
          "from": "../runtime-host-macos/Config/runtime-assets.json",
          "to": "runtime/runtime-assets.json"
        },
        {
          "from": "../runtime-host-macos/.build/runtime-assets/vmlinux-arm64",
          "to": "runtime/vmlinux-arm64"
        },
        {
          "from": "../runtime-host-macos/THIRD_PARTY_NOTICES.md",
          "to": "runtime/THIRD_PARTY_NOTICES.md"
        },
        {
          "from": "../runtime-host-macos/.build/provider-assets",
          "to": "agents"
        }
      ]
    }
  }
}
