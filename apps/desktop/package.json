{
  "name": "@curve-ai/radius-desktop",
  "productName": "Radius",
  "version": "0.0.1",
  "description": "The Radius desktop workspace for local AI agents.",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Curve AI"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/curve-ai/radius.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "dev": "bun --bun run electron-vite dev",
    "start": "bun --bun run electron-vite preview",
    "build": "bun run typecheck && bun run build:bundle",
    "build:bundle": "bun --bun run electron-vite build",
    "package": "bun run build && electron-builder --config electron-builder.config.cjs --dir",
    "make": "bun run build && electron-builder --config electron-builder.config.cjs",
    "lint": "eslint --cache .",
    "test": "ELECTRON_OVERRIDE_DIST_PATH=. tsx --test --test-force-exit 'src/**/*.test.ts' && bun run test:tooling",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:tooling",
    "postinstall": "electron-builder install-app-deps",
    "dev:local": "bun run prepare:browser && bun --env-file=../../.env.local --env-file=.env.local scripts/dev.ts",
    "auth:setup": "bun scripts/configure-auth.ts",
    "auth:check": "bun --env-file=../../.env.local scripts/check-auth.ts",
    "test:tooling": "tsx --test scripts/*.test.ts",
    "prepare:browser": "bun run --cwd ../.. --filter '@curve-ai/radius-browser-*' build",
    "prepare:runtime": "sh ../runtime-host-macos/scripts/build.sh && sh ../runtime-host-macos/scripts/prepare-assets.sh && bash ../runtime-host-macos/scripts/prepare-agents.sh",
    "package:app": "bun run prepare:browser && bun run prepare:runtime && bun run package",
    "make:app": "bun run prepare:browser && bun run prepare:runtime && bun run make",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@curve-ai/platform-client": "0.0.1",
    "@curve-ai/radius-browser-protocol": "0.0.1",
    "@curve-ai/radius-browser-tools": "0.0.1",
    "@curve-ai/radius-mcp-connector": "0.0.1",
    "@curve-ai/radius-runtime": "0.0.1",
    "@curve-ai/radius-scheduler": "0.0.1",
    "@curve-ai/radius-storage": "0.0.1",
    "@curve-ai/radius-sync-core": "0.0.1",
    "@curve-ai/radius-tool-broker": "0.0.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bufferutil": "4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.11",
    "katex": "0.18.4",
    "lucide-react": "^0.554.0",
    "material-icon-theme": "5.37.0",
    "mermaid": "11.17.2",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-flagpack": "^2.0.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-definition-list": "2.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "tailwind-merge": "^3.4.0",
    "utf-8-validate": "6.0.6",
    "@curve-ai/platform-contracts": "0.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.7",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
