# Local dashboard settings; copy to .env.local in this directory.
PORT=3200
RADIUS_PLATFORM_AUTH_MODE=development-token
RADIUS_PLATFORM_API_URL=http://127.0.0.1:3100
RADIUS_PLATFORM_PUBLIC_API_URL=http://localhost:3100
RADIUS_PLATFORM_ACCESS_TOKEN=radius-dev-token
RADIUS_PLATFORM_ALLOW_INSECURE_API=true
