{
  "manifest_version": 3,
  "name": "Radius Browser",
  "description": "Let installed Radius agents use authenticated tabs through the Radius permission broker.",
  "version": "0.0.1",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Radius Browser",
    "default_popup": "popup.html"
  }
}
