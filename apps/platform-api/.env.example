# Local API settings; copy to .env.local. Shared addresses come from ../../.env.local.
PORT=3100
RADIUS_PLATFORM_BOOTSTRAP_DEV_AUTHORITY=true
RADIUS_PLATFORM_ALLOW_INSECURE_SESSIONS=true
RADIUS_PLATFORM_DEV_TOKEN=radius-dev-token
RADIUS_PLATFORM_REGISTRY=127.0.0.1:5001
RADIUS_PLATFORM_REGISTRY_VERIFY=127.0.0.1:5001
RADIUS_PLATFORM_REGISTRY_VERIFY_INSECURE=true
