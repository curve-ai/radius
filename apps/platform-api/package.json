{
  "name": "@curve-ai/radius-platform-api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "admin": "tsx src/admin.ts",
    "dev": "bun run build:auth-ui && bun --watch src/server.ts",
    "build:auth-ui": "vite build --config auth-ui/vite.config.ts",
    "start": "bun src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.auth-ui.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify:sync": "tsx scripts/verify-sync.ts",
    "verify:auth": "bun scripts/verify-embedded-auth.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.2",
    "@curve-ai/platform-contracts": "0.0.1",
    "@curve-ai/platform-database": "0.0.1",
    "@curve-ai/platform-providers": "0.0.1",
    "@curve-ai/radius-sync-protocol": "0.0.1",
    "@radix-ui/react-slot": "1.2.4",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "geist": "1.7.2",
    "hono": "4.13.5",
    "nodemailer": "9.1.0",
    "openid-client": "6.8.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/bun": "1.4.0",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jose": "6.2.10",
    "tailwindcss": "4.2.2",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
