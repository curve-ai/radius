{
  "name": "@curve-ai/radius-storage",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema:generate": "drizzle-kit generate --config drizzle.config.ts --name initial_storage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@curve-ai/radius-connector-protocol": "0.0.1",
    "@curve-ai/radius-sync-protocol": "0.0.1",
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
