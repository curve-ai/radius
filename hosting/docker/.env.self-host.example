# Pin this value before every upgrade. Source builds use it as the local image tag.
RADIUS_VERSION=0.0.1
RADIUS_IMAGE_REGISTRY=ghcr.io/curve-ai

RADIUS_PLATFORM_DOMAIN=agents.example.com
RADIUS_REGISTRY_DOMAIN=registry.example.com
RADIUS_ACME_EMAIL=platform-ops@example.com

# Generate distinct high-entropy values. Never commit the populated file.
RADIUS_POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
RADIUS_REGISTRY_USERNAME=radius
RADIUS_REGISTRY_PASSWORD=replace-with-at-least-32-random-characters
RADIUS_REGISTRY_AUTH_FILE=/absolute/path/to/radius-registry.htpasswd
RADIUS_REGISTRY_HTTP_SECRET=replace-with-at-least-32-random-characters
RADIUS_OIDC_TRANSACTION_SECRET=replace-with-at-least-32-random-characters

# Omit the issuer to use Curve's hosted Better Auth. Custom Better Auth and
# other OIDC providers use their exact issuer URL here.
RADIUS_AUTH_MODE=external
# To host Better Auth inside Platform instead:
# RADIUS_AUTH_MODE=embedded
# RADIUS_AUTH_URL=https://agents.example.com/api/auth
# RADIUS_OIDC_ISSUER=https://agents.example.com/api/auth
# BETTER_AUTH_SECRET=<generate with openssl rand -base64 32>
# RESEND_API_KEY=<your Resend key>
# AUTH_EMAIL_FROM=Radius <auth@your-verified-domain.example>
# The embedded dashboard registers RADIUS_OIDC_CLIENT_ID as a public PKCE
# client. Leave RADIUS_OIDC_CLIENT_SECRET empty in embedded mode.
# RADIUS_OIDC_ISSUER=https://identity.example.com
RADIUS_OIDC_CLIENT_ID=radius-self-host
RADIUS_OIDC_CLIENT_SECRET=replace-with-provider-client-secret
RADIUS_OIDC_ORGANIZATION=acme
RADIUS_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
RADIUS_OIDC_AUTO_JOIN_ROLE=viewer
# Set this to the Account ID printed by bootstrap-owner for the first login,
# then remove it after the identity is linked.
RADIUS_OIDC_BOOTSTRAP_ACCOUNT_ID=

# Paste the public per-organization native client receipt from auth setup.
# Each entry may override issuer; omitted issuer inherits RADIUS_OIDC_ISSUER
# or defaults to https://app.curvehq.sh/api/auth.
RADIUS_NATIVE_AUTH_CONFIG=[]
RADIUS_NATIVE_AUTO_JOIN=false
RADIUS_SYNC_ENABLED=true
RADIUS_SYNC_CURSOR_SECRET=replace-with-at-least-32-random-characters
