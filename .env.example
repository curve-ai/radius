# Local contributor environment only. Copy to .env.local at the repository root.
# Docker Compose runs dependencies; run application services separately with Bun.
RADIUS_POSTGRES_PORT=5442
RADIUS_POSTGRES_DATABASE=radius_development
RADIUS_POSTGRES_PASSWORD=radius-local-development-only
RADIUS_REDIS_PORT=6382
RADIUS_REGISTRY_PORT=5002
DATABASE_URL=postgresql://radius:radius-local-development-only@127.0.0.1:5442/radius_development
JOBS_REDIS_URL=redis://127.0.0.1:6382
HOST=127.0.0.1
NODE_ENV=development
RADIUS_LOCAL_DEVELOPMENT=true
RADIUS_AUTH_MODE=embedded
RADIUS_AUTH_URL=http://localhost:3100/api/auth
RADIUS_OIDC_ALLOW_INSECURE_LOOPBACK=true
# Local development generates a private persistent .radius/auth-secret if empty.
# Other deployments must supply a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Real email delivery (Resend key and verified sender belong to your account).
RADIUS_AUTH_EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional local inbox instead: start the mailpit Compose profile, then set
# RADIUS_AUTH_EMAIL_PROVIDER=smtp
# RADIUS_AUTH_SMTP_URL=smtp://127.0.0.1:1025
# AUTH_EMAIL_FROM=Radius <auth@radius.localhost>
RADIUS_PLATFORM_BOOTSTRAP_DEV_AUTHORITY=true
RADIUS_PLATFORM_DEV_TOKEN=radius-local-development-token
RADIUS_PLATFORM_ALLOW_INSECURE_SESSIONS=true
RADIUS_PLATFORM_URL=http://localhost:3100/
RADIUS_PLATFORM_REGISTRY=127.0.0.1:5002
RADIUS_PLATFORM_REGISTRY_VERIFY=127.0.0.1:5002
RADIUS_PLATFORM_REGISTRY_VERIFY_INSECURE=true
RADIUS_PLATFORM_REGISTRIES=127.0.0.1:5002
RADIUS_PLATFORM_INSECURE_REGISTRIES=127.0.0.1:5002
RADIUS_PLATFORM_ALLOW_INSECURE_LOOPBACK=true
RADIUS_SYNC_ENABLED=true
RADIUS_SYNC_CURSOR_SECRET=radius-local-only-sync-cursor-secret-change-for-production
RADIUS_SYNC_ARTIFACT_PATH=./.radius/sync-artifacts
# Dashboard fixture access for local development (desktop still uses real sign-in).
RADIUS_PLATFORM_AUTH_MODE=development-token
RADIUS_PLATFORM_API_URL=http://127.0.0.1:3100
RADIUS_PLATFORM_PUBLIC_API_URL=http://localhost:3100
RADIUS_PLATFORM_ACCESS_TOKEN=radius-local-development-token
RADIUS_PLATFORM_ALLOW_INSECURE_API=true
