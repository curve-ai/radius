{
  "name": "@curve-ai/radius",
  "version": "0.0.1",
  "private": true,
  "description": "The open-source runtime and delivery platform for specialized AI agents.",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*",
    "hosting"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.23.4"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "fast-uri": "3.1.9",
    "esbuild": "0.28.1",
    "katex": "0.18.4",
    "postcss-selector-parser": "6.1.5"
  },
  "trustedDependencies": [
    "@curve-ai/radius-desktop",
    "electron",
    "electron-winstaller",
    "esbuild"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev:local",
    "dev:platform": "bun run --cwd apps/platform-api dev:local",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "package": "bun run --cwd apps/desktop package:app",
    "make": "bun run --cwd apps/desktop make:app",
    "release:npm:verify": "turbo run build --filter='./packages/*' && bun scripts/release/npm.ts --verify",
    "release:npm:pack": "turbo run build --filter='./packages/*' && bun scripts/release/npm.ts --output .radius/releases/npm",
    "ci:verify": "turbo run typecheck lint test build:bundle --summarize --output-logs=errors-only",
    "agent:prepare-fx:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-fx-agent-windows.ps1",
    "agents:prepare:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-bundled-agents-windows.ps1",
    "runtime:windows:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-runtime-host-windows.ps1",
    "runtime:windows:prepare-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime-assets-windows.ps1",
    "cli:link": "bun link --cwd packages/cli-next",
    "cli:unlink": "bun unlink --cwd packages/cli-next",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:changed": "bun fmt --changed=HEAD",
    "format:changed:check": "bun fmt --changed=HEAD --check"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
